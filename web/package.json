{
  "name": "altim-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./src/index.html",
    "build": "rm -rf dist && bun build ./src/index.html --outdir ./dist --production --public-path=/",
    "start": "bun ./server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "secrets": "bun ./scripts/secrets.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
