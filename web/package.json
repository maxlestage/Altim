{
  "name": "altim-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./src/index.html",
    "build": "rm -rf dist && bun build ./src/index.html --outdir ./dist --production --public-path=/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "secrets": "bun ./scripts/secrets.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
